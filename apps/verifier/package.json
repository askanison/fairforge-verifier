{
  "name": "@fairforge/verifier-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "preview": "vite preview --host 127.0.0.1 --port 4176 --strictPort",
    "build": "npm run build --workspace=@fairforge/verifier && tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@fairforge/verifier": "0.1.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1"
  }
}
